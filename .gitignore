# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# .vscode/settings.json is machine-specific (per-machine Flutter SDK path).
# Keep it out of version control. launch.json and tasks.json are shared.
.vscode/settings.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
.tool/
/build/
/build_support/
/build_support
/coverage/
# The ledger's source of truth is database/driver_work/ (JSON); the SQLite
# file is a cache rebuilt from it by scripts/driver_work.py.
/database/driver_work.sqlite3
/database/.driver_work-*.sqlite3
/database/*.sqlite3-journal
/database/*.sqlite3-shm
/database/*.sqlite3-wal
tools/newchirp_scsi_mac

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# OKF lookup caches are large machine-generated indexes with absolute paths.
okf_bundle/.okf_lookup_cache.json
okf_bundle_scripts/.okf_lookup_cache.json

# Local operator-only agent prompts.
/prompts/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Installers and mobile packages are published by upload only, never to GitHub.
*.apk
*.aab
*.ipa
*.msi
*.msix
*.dmg
*.deb
*.rpm
*.AppImage
*.pkg.tar.zst
NewChirp-Installer-*.exe
newchirp-setup*.exe
